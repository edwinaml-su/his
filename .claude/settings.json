{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-merge.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__.*__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-sql-reapply.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/warn-payloads.mjs"
          }
        ]
      }
    ]
  }
}
