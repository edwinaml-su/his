# Ejemplo de variables de entorno para apps/web.
# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
# NUNCA commitear .env.local con valores reales.

# ── Supabase (ya existentes, normalmente vienen heredadas) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ── App / invitaciones de usuario (CC-0019) ──────────────────────────────────
# Base pública usada para construir el enlace de "fijar contraseña" del alta
# de usuario (userAdmin.create/resendInvitation). Se INLINEA en build time
# (prefijo NEXT_PUBLIC_) — debe estar seteada en Vercel Production/Preview o
# los enlaces de invitación quedarán apuntando a localhost.
NEXT_PUBLIC_APP_URL=https://his.example.com

# ── SMTP Microsoft 365 (envío de invitaciones/recuperación — CC-0019) ───────
# Adapter en packages/infrastructure/src/notifications/smtp.ts. Probar con
# /admin/email-test tras configurar.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@complejoavante.com
SMTP_PASS=set-via-vercel-env-vars
SMTP_FROM=notificaciones@complejoavante.com
SMTP_FROM_NAME=HIS Avante

# ── Odoo XML-RPC ────────────────────────────────────────────────────────────
# Cliente en packages/infrastructure/src/odoo/client.ts.
# Usuario debe ser service-account dedicado con permisos mínimos.
# Rotar password trimestralmente. NUNCA hardcodear en código.
ODOO_URL=https://odoo.example.com
ODOO_DB=YourDatabaseName
ODOO_USER=service.account@example.com
ODOO_PASSWORD=set-via-vercel-env-vars

# ── GitHub (opcional — Wave 7 KPI gob_cambios_estandar) ─────────────────────
GITHUB_TOKEN=ghp_xxx
